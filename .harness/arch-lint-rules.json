{
  "version": 1,
  "rules": [
    {
      "id": "source-file-size",
      "type": "max_file_lines",
      "globs": [
        "**/*.go",
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.html",
        "**/*.css",
        "**/*.py",
        "**/*.sh",
        "**/*.sql",
        "**/*.svelte",
        "**/*.swift",
        "**/*.vue",
        "**/*.rs",
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.scss"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/vendor/**",
        "**/.venv/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/generated/**",
        "**/gen/**",
        "**/*.generated.*",
        "**/*.min.js",
        "**/*.min.css"
      ],
      "max_lines": 1000,
      "warn_lines": 500,
      "legacy": {
        "internal/studio/templates/player.html": {
          "lines": 4083,
          "reason": "Existing engine-owned embedded player predates the ecosystem guardrails.",
          "plan": "VE-10: extract cohesive player modules while preserving assembled HTML and offline builds."
        }
      },
      "message": "Split source along a cohesive responsibility boundary."
    },
    {
      "id": "architecture-document-present",
      "type": "require_path",
      "path": ".harness/ARCHITECTURE.md",
      "message": "The repository must retain its architecture document."
    },
    {
      "id": "canonical-plugin-skills-present",
      "type": "require_path",
      "path": "plugin/skills",
      "message": "The public repository must remain the canonical source for Vessica Studio plugin skills."
    },
    {
      "id": "downstream-agent-guide-present",
      "type": "require_path",
      "path": "codex/AGENTS.md",
      "message": "Initialized studios must continue to receive the downstream agent guide."
    },
    {
      "id": "no-committed-environment-files",
      "type": "forbid_path",
      "glob": "**/.env*",
      "exclude": [
        "**/.env*.example",
        "**/.env*.sample",
        "**/.env*.template"
      ],
      "message": "Do not commit environment secret files; commit only example, sample, or template variants."
    },
    {
      "id": "go-dependency-guard-present",
      "type": "require_path",
      "path": "internal/architecture/architecture_test.go",
      "message": "Retain the AST-based Go dependency guard."
    },
    {
      "id": "no-private-platform-sdk",
      "type": "forbid_path",
      "glob": "**/vessica-platform*.tgz",
      "message": "The public engine cannot ship the private Platform SDK."
    }
  ]
}
